<Window x:Class="Modul_3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modul-1 - Система тестирования разъемов" 
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Модуль-1" 
                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" 
                   Margin="0,0,0,30"/>

        <!-- Основные поля ввода -->
        <StackPanel Grid.Row="1" Width="400">
            <!-- Позиция (выбор изделия) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Позиция:" FontWeight="Bold"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Products}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedProduct}"/>
            </Grid>

            <!-- Номер изделия -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Номер:" FontWeight="Bold"/>
                <TextBox Grid.Column="1" 
                         Text="{Binding ProductNumber, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Оператор -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Оператор:" FontWeight="Bold"/>
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Operators}"
                          SelectedItem="{Binding SelectedOperator}"/>
            </Grid>
            
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" Width="400">
            <Button Content="Старт" 
                    Command="{Binding StartCommand}"
                    Background="LightGreen"
                    Foreground="Black"
                    FontWeight="Bold">
            </Button>
            <Button Content="Продолжить" 
                    Command="{Binding ResumeSessionCommand}"
                    Background="#FF6CB4B9" 
                    Foreground="Black" 
                    FontWeight="Bold"/>
                    

            <Button Content="Редактор" 
                    Command="{Binding EditorCommand}"
                    Background="#FF2196F3" 
                    Foreground="Black" 
                    FontWeight="Bold"/>
            
        </StackPanel>

        <!-- Статусная строка -->
        <StatusBar Grid.Row="3" Margin="0,10,0,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Модуль-1:" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ArduinoStatus}" Margin="5,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ArduinoStatus}" Value="Подключено">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ArduinoStatus}" Value="Ошибка подключения">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ArduinoStatus}" Value="Модуль-1 не найден">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ArduinoStatus}" Value="Поиск Модуль-1...">
                                        <Setter Property="Foreground" Value="Orange"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ArduinoStatus}" Value="Готов к работе">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
