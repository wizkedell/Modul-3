<Window x:Class="Modul_3.Views.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Modul_3.Converters"
        xmlns:views="clr-namespace:Modul_3.Views"
        Title="Контроль распайки разъемов" Height="1050" Width="1302"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinWidth="1000" MinHeight="600" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
        <Style x:Key="ConnectorListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="LightCoral"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Left" 
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="LightGreen"/>
                                <Setter Property="Foreground" Value="DarkGreen"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="Gray"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="Gray"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderThickness" Value="5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="41"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с информацией и кнопками -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Width="538">
            <TextBlock Text="Изделие: " FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="{Binding ProductInfo}" Margin="5,0,20,0" FontSize="18"/>
            <TextBlock Text="Номер: " FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="{Binding ProductNumber}" Margin="5,0,20,0" FontSize="18"/>
            <TextBlock Text="Оператор: " FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="{Binding Operator}" Margin="5,0,20,0" FontSize="18"/>
            

        </StackPanel>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10" Width="349">
            <Button Content="Пауза" Command="{Binding PauseCommand}" Width="54" Height="30" FontSize="18" />
            <Button Content="Сброс" Command="{Binding ResetModuleCommand}" Margin="15,0"  Width="74" FontSize="18"/>
            <Button Content="Завершить прозвонку" Command="{Binding FinishTestCommand}" Width="190" FontSize="18"/>
            

        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - управление -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <TextBlock Text="Разъемы изделия" 
                           FontWeight="Bold" 
                           FontSize="14" 
                           Margin="10,10,10,5" Width="201"/>

                <ListBox ItemsSource="{Binding Connectors}"
                         DisplayMemberPath="Name"
                         SelectedItem="{Binding SelectedConnector}"
                         ItemContainerStyle="{StaticResource ConnectorListItemStyle}"
                         Margin="10,0,10,10"
                         Height="487"
                         FontSize="18"
                         FontWeight="Bold" Width="204" SelectedIndex="0"/>

                <Separator Margin="10,0,10,10"/>

                <!-- Настройка задержки активации -->
                <StackPanel Margin="10">
                    <TextBlock Text="Задержка активации (мс):" 
                               FontWeight="Bold" 
                               Margin="0,0,0,5"/>
                    <Slider Minimum="100" Maximum="2000" 
                            Value="{Binding GlobalActivationDelay}"
                            TickFrequency="100"
                            TickPlacement="BottomRight"
                            Margin="0,5"/>
                    <TextBlock Text="{Binding GlobalActivationDelay, StringFormat='{}{0} мс'}" 
                               HorizontalAlignment="Center"
                               FontSize="10"/>
                </StackPanel>

                <Separator Margin="10,0,10,10"/>

                <!-- Диагностические сообщения -->
                <StackPanel Margin="10">
                    <TextBlock Text="Диагностика:" 
                               FontWeight="Bold" 
                               Margin="0,0,0,5"/>
                    <Border Background="White" 
                            BorderBrush="LightGray" 
                            BorderThickness="1" 
                            CornerRadius="3"
                            Padding="8"
                            Height="120">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding DiagnosticMessage}" 
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="DarkRed"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <Separator Margin="10,10,10,5"/>

                <!-- Статус -->
                <StackPanel Margin="10">
                    <TextBlock Text="Режим контроля" 
                               FontWeight="Bold" 
                               Foreground="Green"/>
                    <TextBlock Text="Маркеры отображают состояние контактов в реальном времени" 
                               FontSize="10" 
                               FontStyle="Italic" 
                               Foreground="Gray" 
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Правая панель - область изображения -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto" MinHeight="195"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Окно активных контактов -->
                <Border
                        Background="White" 
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveCaptionBrushKey}}" 
                        BorderThickness="2" 
                        CornerRadius="5"
                        Padding="8"
                        Margin="0,43,0,5" HorizontalAlignment="Center" Width="424" Grid.RowSpan="2" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ActiveMarkerText}" 
                                   FontSize="84"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="DodgerBlue"/>
                    </ScrollViewer>
                </Border>

                <!-- Заголовок выбранного разъема -->
                <TextBlock Grid.Row="0" 
                           Text="{Binding SelectedConnector.Name, StringFormat=' {0}'}"
                           FontSize="25" 
                           FontWeight="Bold" 
                           Margin="0,0,0,10"/>

                <!-- Контейнер для изображения -->
                <Border Grid.Row="2"
                        BorderBrush="LightGray" 
                        BorderThickness="1" 
                        Background="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="800"
                        Height="600">

                    <Grid x:Name="ImageContainer">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="121*"/>
                            <ColumnDefinition Width="677*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Изображение -->
                        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}" 
                               Stretch="Uniform"
                               x:Name="ConnectorImage"
                               MaxWidth="800"
                               MaxHeight="600" Grid.ColumnSpan="2"/>

                        <!-- Canvas для маркеров -->
                        <Canvas x:Name="MarkersCanvas" 
                                Width="800" 
                                Height="600"
                                Background="Transparent" Grid.ColumnSpan="2" Margin="0,0,-2,-2">
                            <!-- Маркеры будут добавляться здесь в code-behind -->
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Статусная строка -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding ArduinoStatus}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>